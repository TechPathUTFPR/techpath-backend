PORT=3000

POSTGRES_USER=techpath
POSTGRES_PASSWORD=techpath
POSTGRES_DB=techpath
POSTGRES_PORT=5432

NGINX_PORT=80

# Conexão usada pelo Prisma ao rodar a API FORA do Docker.
# (No docker-compose ela é montada automaticamente apontando para o serviço "postgres".)
DATABASE_URL=postgres://techpath:techpath@localhost:5432/techpath

# Autenticação do administrador
JWT_SECRET=troque_por_um_segredo
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque_esta_senha

# E-mail (SMTP). Sem SMTP_HOST o envio de e-mail fica desativado e a API sobe normalmente.
# Desenvolvimento com Mailpit (docker-compose): host localhost, porta 1025, sem usuário/senha.
SMTP_HOST=localhost
SMTP_PORT=1025
# TLS direto (porta 465). Padrão: true só na 465.
SMTP_SECURE=false
# Exige STARTTLS em conexões não "secure" (use true em produção na porta 587).
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TechPath <no-reply@techpath.local>
# Opcionais (valores padrão): timeout em ms, retentativas extras, espera base entre elas.
# SMTP_TIMEOUT_MS=10000
# MAIL_MAX_RETRIES=2
# MAIL_RETRY_DELAY_MS=500
